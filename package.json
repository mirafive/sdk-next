{
  "name": "@mirafive/sdk-next",
  "version": "1.0.0",
  "description": "MIRA FIVE SDK for Next.js",
  "keywords": [
    "ab-testing",
    "analytics",
    "cookieless",
    "feature-flags",
    "gdpr",
    "mirafive",
    "nextjs",
    "privacy",
    "react"
  ],
  "homepage": "https://mirafive.io",
  "bugs": {
    "email": "support@mirafive.io"
  },
  "license": "MIT",
  "author": "MIRA FIVE <support@mirafive.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirafive/sdk-next.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "size": "size-limit",
    "example": "sh scripts/example.sh",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && publint --strict && attw --pack --profile esm-only && size-limit",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@mirafive/sdk-browser": "^1.0.0",
    "@mirafive/sdk-react": "^1.0.0",
    "@mirafive/sdk-server": "^1.0.0",
    "@size-limit/preset-small-lib": "^14.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^20.14.5",
    "next": "^16.3.6",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "size-limit": "^14.0.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "peerDependencies": {
    "@mirafive/sdk-browser": "^1.0.0",
    "@mirafive/sdk-react": "^1.0.0",
    "@mirafive/sdk-server": "^1.0.0",
    "next": "^15.1.0 || ^16.0.0",
    "react": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@mirafive/sdk-server": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "name": "client",
      "path": "dist/index.js",
      "import": "*",
      "gzip": true,
      "limit": "1.2 kB"
    },
    {
      "name": "server",
      "path": "dist/server.js",
      "import": "*",
      "gzip": true,
      "limit": "1 kB",
      "ignore": [
        "server-only"
      ]
    }
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.4.2"
}
